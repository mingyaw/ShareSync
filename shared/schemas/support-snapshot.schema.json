{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharesync.local/schemas/support-snapshot.schema.json",
  "title": "ShareSync Support Snapshot",
  "type": "object",
  "required": ["schemaVersion", "type", "platform", "generatedAt", "appVersion", "phase", "nextStep", "transport", "sync", "redaction"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "type": { "type": "string", "const": "sharesync_support_snapshot" },
    "platform": { "type": "string", "enum": ["android", "ios"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "appVersion": { "type": "string", "minLength": 1 },
    "buildNumber": { "type": "integer" },
    "phase": { "type": "string", "minLength": 1 },
    "nextStep": {
      "type": "string",
      "enum": [
        "allow_android_photos",
        "start_android_sharing",
        "wait_for_android_server",
        "scan_from_iphone",
        "wait_for_retry_resume",
        "wait_for_new_android_photos",
        "scan_android_qr",
        "review_android_endpoint",
        "allow_iphone_photos",
        "keep_sharesync_open",
        "fetch_latest_manifest",
        "sync_remaining_photos"
      ]
    },
    "transport": { "type": "string", "minLength": 1 },
    "endpoint": { "type": ["string", "null"] },
    "binding": { "type": "string" },
    "permissions": {
      "type": "object"
    },
    "android": {
      "type": "object"
    },
    "ios": {
      "type": "object"
    },
    "latestRequest": {
      "type": "object"
    },
    "sync": {
      "type": "object"
    },
    "redaction": {
      "type": "object",
      "required": ["pairingToken", "requestSignature", "sharedSecret"],
      "properties": {
        "pairingToken": { "type": "string", "const": "excluded" },
        "requestSignature": { "type": "string", "const": "excluded" },
        "sharedSecret": { "type": "string", "const": "excluded" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
